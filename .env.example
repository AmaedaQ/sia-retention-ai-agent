# --- Reasoning layer (existing) ---
GROQ_API_KEY=your_actual_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- ML risk-scoring layer (Phase 0+) ---
# Rollback switch: false = use the original heuristic formula in
# agents/monitor.py. Flip to true once a real model is published (Phase 2).
USE_ML_MODEL=false

# Hugging Face model repo + pinned revision the trained model lives at
# (set once Phase 2 publishes it). Never left as "latest".
HF_MODEL_REPO=
HF_MODEL_REVISION=v1.0.0

CHURN_RISK_THRESHOLD=0.7
SHAP_TOP_K=3
